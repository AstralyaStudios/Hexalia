{
  "multipart": [
    {
      "apply": {
        "model": "hexalia:block/herb_jar"
      },
      "when": {
        "facing": "north"
      }
    },
    {
      "apply": {
        "model": "hexalia:block/jar_tag"
      },
      "when": {
        "facing": "north",
        "has_contents": "true"
      }
    },
    {
      "apply": {
        "model": "hexalia:block/herb_jar",
        "y": 90
      },
      "when": {
        "facing": "east"
      }
    },
    {
      "apply": {
        "model": "hexalia:block/jar_tag",
        "y": 90
      },
      "when": {
        "facing": "east",
        "has_contents": "true"
      }
    },
    {
      "apply": {
        "model": "hexalia:block/herb_jar",
        "y": 180
      },
      "when": {
        "facing": "south"
      }
    },
    {
      "apply": {
        "model": "hexalia:block/jar_tag",
        "y": 180
      },
      "when": {
        "facing": "south",
        "has_contents": "true"
      }
    },
    {
      "apply": {
        "model": "hexalia:block/herb_jar",
        "y": 270
      },
      "when": {
        "facing": "west"
      }
    },
    {
      "apply": {
        "model": "hexalia:block/jar_tag",
        "y": 270
      },
      "when": {
        "facing": "west",
        "has_contents": "true"
      }
    }
  ]
}
