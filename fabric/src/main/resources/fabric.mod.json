{
	"schemaVersion": 1,
	"id": "hexalia",
	"version": "${version}",
	"name": "Hexalia",
	"description": "Hexalia is a folk-witchcraft Minecraft mod centered on nature, cultivation, herbal practices, rituals, environmental magic, and handcrafted magical tools.",
	"authors": [
		"Astralya Studios"
	],
	"contact": {
		"homepage": "https://github.com/AstralyaStudios/Hexalia",
		"sources": "https://github.com/AstralyaStudios/Hexalia"
	},
	"license": "MIT",
	"icon": "assets/hexalia/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.astralya.hexalia.HexaliaFabric"
		],
		"client": [
			"net.astralya.hexalia.HexaliaModClient"
		],
		"rei_client": [
			"net.astralya.hexalia.compat.rei.HexaliaREIClientPlugin"
		],
		"jei_mod_plugin": [
			"net.astralya.hexalia.compat.jei.JEIPlugin"
		],
		"emi": [
			"net.astralya.hexalia.compat.emi.HexaliaEmiPlugin"
		]
	},
	"mixins": [
		"hexalia.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.15.6",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"architectury": ">=9.2.14",
		"fabric-api": "*"
	},
	"suggests": {
		"trinkets": "*",
		"accessories": "*"
	}
}
