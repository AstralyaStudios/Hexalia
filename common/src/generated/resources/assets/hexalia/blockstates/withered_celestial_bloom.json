{
  "multipart": [
    {
      "apply": {
        "model": "hexalia:block/withered_celestial_bloom_closed"
      },
      "when": {
        "open": "false"
      }
    },
    {
      "apply": {
        "model": "hexalia:block/withered_celestial_bloom_open"
      },
      "when": {
        "open": "true"
      }
    },
    {
      "apply": {
        "model": "hexalia:block/celestial_bloom_open_emissive"
      },
      "when": {
        "open": "true"
      }
    }
  ]
}